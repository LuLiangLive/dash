  "task_templates": {
    "encoding_safety": {
      "category": "code",
      "description": "编码安全：含中文文件(.vue/.py/.md)必须用Python脚本指定encoding=utf-8修改，禁止用PowerShell Set-Content",
      "priority": "high",
      "always": true
    },
    "refactor_safety": {
      "category": "code",
      "description": "重构安全：拆分/移动代码前先备份原文件到临时目录；禁止批量正则删除函数，必须逐函数操作；拆分后立即验证语法+所有API端点存在+调用链完整",
      "priority": "high",
      "change_types": [
        "refactor"
      ]
    },
    "data_check": {
      "category": "data",
      "description": "检查是否需要数据库表结构变更或数据迁移（如不涉及可直接标记完成）",
      "priority": "medium",
      "always": true
    },
    "doc_update": {
      "category": "doc",
      "description": "更新功能链文档/变更说明",
      "priority": "medium",
      "always": true
    },
    "architecture_read": {
      "category": "doc",
      "description": "阅读系统架构文档（backend/docs/SYSTEM_ARCHITECTURE.md），确认变更涉及的模块和文件",
      "priority": "high",
      "always": true
    },
    "graph_sync": {
      "category": "graph",
      "description": "更新功能神经网络：节点状态/版本/检查点/新增边",
      "priority": "high",
      "always": true
    },
    "version_bump": {
      "category": "version",
      "description": "升级三处版本号：backend/config.py(APP_VERSION) + src/utils/version.ts + _pack.py(VERSION)",
      "priority": "high",
      "always": true
    },
    "build_deploy": {
      "category": "build",
      "description": "构建前端(npm run build)并复制到backend/static，清理旧assets，验证页面可正常访问",
      "priority": "high",
      "always": true
    },
    "graph_code_files_check": {
      "category": "graph",
      "description": "验证神经网络节点的code_files路径：用Python脚本检查每个code_files是否真实存在（路径基准为项目根目录）",
      "priority": "high",
      "change_types": [
        "graph_node_add",
        "graph_node_modify"
      ]
    },
    "graph_data_spec_check": {
      "category": "graph",
      "description": "对照graph_data_convention规范检查节点/边字段格式：id命名、version格式、status/verify_result/layer枚举值、known_issues字段结构、边的label必填",
      "priority": "medium",
      "change_types": [
        "graph_node_add",
        "graph_node_modify",
        "graph_edge_add"
      ]
    }
  },
  "tech_stack": {
    "frontend": "Vue 3 + Vite + TypeScript + Pinia + Naive UI + ECharts",
    "backend": "Python + FastAPI + Uvicorn",
    "database": "SQLite",
    "build": "npm run build → dist/ → backend/static/"
  },
  "graph_data_convention": {
    "node": {
      "id": "小写+下划线，如 data_source、one_click_update",
      "version": "统一不带v前缀，如 2.9.23（与config.py的APP_VERSION格式一致）",
      "status": "枚举：healthy / warning / error / pending",
      "verify_result": "枚举：pass / pending / needs_recheck",
      "layer": "枚举：data / business / display / system",
      "code_files": "统一从项目根目录开始，用/分隔，如 backend/modules/nav/fetcher.py、src/views/WatchView.vue",
      "config_keys": "统一用config.py中的配置项名（小写），不用大写常量",
      "check_points": "字符串数组，5-15个，每项是可验证的检查点",
      "known_issues": {
        "required_fields": [
          "id",
          "status",
          "description",
          "found_version"
        ],
        "optional_fields": [
          "fixed_version",
          "root_cause",
          "solution",
          "severity"
        ],
        "status_enum": [
          "open",
          "in_progress",
          "resolved",
          "reopened"
        ]
      }
    },
    "edge": {
      "type": "枚举：data_flow / affects / call / test_related / dependency / ui_sync / doc_sync / constrains",
      "label": "必填，简短描述边的含义",
      "description": "可选，详细说明"
    },
    "non_propagating_edge_types": [
      "constrains",
      "doc_sync"
    ]
  },
  "mandatory_rules": [
    {
      "id": "RULE-001",
      "name": "功能修改必须先走变更准入网关",
      "description": "所有功能修改、优化、新增、重构等变更，必须主动先走变更准入网关流程（影响范围分析 + 受影响节点检查 + 风险点识别 + 检查清单），不需要用户提醒。禁止跳过网关直接修改代码。",
      "trigger": "任何涉及代码修改的功能变更",
      "enforcement": "强制",
      "created_at": "2026-09-06T14:28:04.161509"
    },
    {
      "id": "RULE-002",
      "name": "变更完成后必须记录到功能神经网络",
      "description": "所有功能变更完成后，必须主动记录到change_history.json（变更历史），不需要用户提醒。记录内容包括：变更ID、标题、类型、优先级、描述、目标节点、修改文件、关键变更、风险处理、验证结果。",
      "trigger": "任何功能变更完成后",
      "enforcement": "强制",
      "created_at": "2026-09-06T14:28:04.161527"
    },
    {
      "id": "RULE-003",
      "name": "版本号必须随功能变更升级",
      "description": "每次功能变更完成后，必须主动升级版本号（前端package.json + 后端版本配置 + 功能链文档），不需要用户提醒。禁止修改了功能但版本号不变。",
      "trigger": "任何功能变更完成后",
      "enforcement": "强制",
      "created_at": "2026-09-06T14:28:04.161529"
    },
    {
      "id": "RULE-004",
      "name": "修改含中文文件必须用Python脚本指定UTF-8编码",
      "description": "修改任何包含中文的文件（.json/.md/.py/.vue/.ts等），必须使用Python脚本指定encoding='utf-8'，禁止使用PowerShell Set-Content或其他可能导致编码问题的方式。",
      "trigger": "修改含中文的文件",
      "enforcement": "强制",
      "created_at": "2026-09-06T14:28:04.161530"
    },
    {
      "id": "RULE-005",
      "name": "数据准确优先，禁止兜底糊弄",
      "description": "数据显示必须准确，不准确就显示'—'或明确标注，禁止用前一天数据兜底、用缓存数据冒充实时数据、用估算值冒充真实数据。",
      "trigger": "任何涉及数据显示的功能",
      "enforcement": "强制",
      "created_at": "2026-09-06T14:28:04.161530"
    }
  ]
}