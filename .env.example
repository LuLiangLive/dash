# ============================================================
# 投研看板 v2.7.1 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# ============================================================

# ── 基础配置 ──────────────────────────────────────────────
APP_VERSION=2.7.1
DB_PATH=./fund.db
TZ=Asia/Shanghai
ROLE=api
PORT=8000

# ── API 鉴权 ──────────────────────────────────────────────
# API 密钥（逗号分隔多个），生产环境务必修改
API_KEYS=your-secure-api-key-here
# 读操作是否也需要 API Key（默认 false，内网开放读）
REQUIRE_READ_KEY=false

# ── 采集配置 ──────────────────────────────────────────────
FULL_MARKET=false
COLLECT_MAX=6000
COVER_FLOOR=2000

# ── 敏感数据加密（v2.7.1 新增）──────────────────────────
# 加密密钥（base64 编码的 32 字节密钥，使用 Fernet 算法）
# 生成方法: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 生产环境务必设置！未设置时会自动生成开发密钥并保存到 data/.encryption_key
ENCRYPTION_KEY=

# ── API 限流（v2.7.1 新增）───────────────────────────────
# 是否启用限流
RATE_LIMIT_ENABLED=true
# 默认限流策略（所有接口）
RATE_LIMIT_DEFAULT=60/minute
# 搜索/查询类接口限流
RATE_LIMIT_SEARCH=30/minute
# 行情接口限流
RATE_LIMIT_MARKET=120/minute
# 提醒接口限流
RATE_LIMIT_ALERT=20/minute
# 管理接口限流
RATE_LIMIT_ADMIN=10/minute

# ── 安全响应头（v2.7.1 新增）─────────────────────────────
# 是否启用安全响应头
SECURITY_HEADERS_ENABLED=true
# 是否启用内容安全策略（CSP）
CSP_ENABLED=true
# 自定义 CSP 策略（不填使用默认值）
CSP_POLICY=
# 是否启用 HSTS（仅 HTTPS 环境建议开启）
HSTS_ENABLED=false

# ── 评分权重 ──────────────────────────────────────────────
EARN_WEIGHT=0.5
AD_WEIGHT=0.5

# ── auto_update 配置 ──────────────────────────────────────
MIN_FUNDS=3000
MIN_DB_MB=5
MAX_ERRORS=50
PUBLIC_URL=https://your-domain.com/
